{
  "name": "pediritos",
  "version": "1.0.0",
  "description": "Plataforma de pedidos baseada em microsserviços.",
  "scripts": {
    "dev": "turbo run start:dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "clean": "turbo run clean",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm -r --if-present db:migrate",
    "db:seed": "pnpm -r --if-present db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "turbo": "^2.5.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@types/node": "^26.4.1"
  }
}
