NODE_ENV=development

# Local development only. Replace secrets for any non-local deployment.
POSTGRES_USER=pediritos
POSTGRES_PASSWORD=pediritos_dev_only
POSTGRES_DB=pediritos
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_USER=pediritos
RABBITMQ_PASSWORD=pediritos_dev_only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
CATALOG_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
PAYMENT_SERVICE_PORT=3004
STOCK_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006

# Used by local runs outside Docker. Compose provides service-specific DB URLs.
DATABASE_URL=postgresql://pediritos:pediritos_dev_only@localhost:5432/pediritos_auth
RABBITMQ_URL=amqp://pediritos:pediritos_dev_only@localhost:5672
REDIS_URL=redis://localhost:6379
JWT_SECRET=local-development-secret-change-before-deploy-32chars
JWT_REFRESH_SECRET=local-refresh-secret-change-before-deploy-32chars
AUTH_ACTION_ENCRYPTION_KEY=local-action-encryption-key-change-before-deploy-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Optional local seed administrator. Set both values to create/update the account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Pediritos <no-reply@pediritos.local>
